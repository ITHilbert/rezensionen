{
    "name": "ithilbert/rezensionen",
    "type": "library",
    "license": "MIT",
    "description": "Neues Package für Rezensionen",
    "keywords": [
        "it-hilbert",
        "laravel",
        "homepage"
    ],
    "authors": [
        {
            "name": "Jörg Hilbert",
            "homepage": "https://www.it-hilbert.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://www.it-hilbert.com",
    "minimum-stability": "dev",
    "require": {
        "php": "^8.5",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "ITHilbert\\Rezensionen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ITHilbert\\Rezensionen\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ITHilbert\\Rezensionen\\RezensionenServiceProvider"
            ],
            "aliases": {}
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    }
}
